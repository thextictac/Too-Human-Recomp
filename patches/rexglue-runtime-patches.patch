+// PORT DIAGNOSTIC: wait/signal graph logging. Remove once game runs.
+#include <unordered_set>
+#include <mutex>
+namespace {
+std::mutex g_portdiag_mutex;
+std::unordered_set<std::string> g_portdiag_seen;
+uint32_t PortDiagLr() {
+  auto* ctx = rex::runtime::current_ppc_context();
+  return ctx ? ctx->lr : 0;
+}
+
+void PortDiagWait(const char* kind, uint32_t obj, uint64_t timeout, bool has_timeout) {
+  auto* t = rex::system::XThread::GetCurrentThread();
+  uint32_t tid = t ? t->thread_id() : 0;
+  std::lock_guard<std::mutex> lock(g_portdiag_mutex);
+  auto key = std::string(kind) + std::to_string(tid) + "_" + std::to_string(obj);
+  if (g_portdiag_seen.insert(key).second) {
+    REXKRNL_INFO("[port-diag] {} thread={} obj={:#x} timeout={} (blocking={}) lr={:08x}",
+                 kind, tid, obj, has_timeout ? (int64_t)timeout : -1,
+                 (!has_timeout || timeout != 0) ? "YES" : "no", PortDiagLr());
+  }
+}
+
+void PortDiagInit(uint32_t obj) {
+  std::lock_guard<std::mutex> lock(g_portdiag_mutex);
+  auto key = "INIT_" + std::to_string(obj);
+  if (g_portdiag_seen.insert(key).second) {
+    REXKRNL_INFO("[port-diag] INIT-EVENT obj={:#x} lr={:08x}", obj, PortDiagLr());
+  }
+}
+void PortDiagSignal(const char* kind, uint32_t obj) {
+  auto* t = rex::system::XThread::GetCurrentThread();
+  uint32_t tid = t ? t->thread_id() : 0;
+  std::lock_guard<std::mutex> lock(g_portdiag_mutex);
+  static uint32_t sig_count = 0;
+  if (++sig_count <= 100) {
+    REXKRNL_INFO("[port-diag] {} thread={} obj={:#x} lr={:08x} (#{}.)",
+                 kind, tid, obj, PortDiagLr(), sig_count);
+  }
+}
+}  // namespace
